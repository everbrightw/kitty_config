{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "command-raw",
    "source": "~/.local/bin/pokemon-art",
    "padding": { "right": 3 }
  },
  "display": { "separator": "  " },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[1;38;2;255;255;255mPOKÉDEX // TERMINAL\u001b[0m"
    },
    { "type": "separator", "outputColor": "white" },
    { "type": "os", "keyColor": "white", "outputColor": "white" },
    { "type": "uptime", "keyColor": "white", "outputColor": "white" },
    { "type": "shell", "keyColor": "white", "outputColor": "white" },
    { "type": "terminal", "keyColor": "white", "outputColor": "white" },
    { "type": "terminalfont", "keyColor": "white", "outputColor": "white" },
    { "type": "cpu", "keyColor": "white", "outputColor": "white" },
    { "type": "memory", "keyColor": "white", "outputColor": "white" },
    {
      "type": "disk",
      "folders": "/",
      "keyColor": "white",
      "outputColor": "white"
    },
    { "type": "battery", "keyColor": "white", "outputColor": "white" },
    {
      "type": "command",
      "key": "Editor",
      "text": "nvim --version | head -1 | sed 's/NVIM //'",
      "keyColor": "white",
      "outputColor": "white"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;255;255;255mCharizard × Chansey · Eldritch edition\u001b[0m"
    }
  ]
}
